# Copiá este archivo como .env.local y completá los valores.
# Todo lo que empieza con VITE_ termina en el JS público del sitio:
# NUNCA pongas acá secretos (service key de Supabase, tokens, webhooks).

# Supabase (Project Settings → API). La anon/publishable key es pública por diseño;
# la seguridad real la dan las políticas RLS.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Opcional: URL del Worker de Cloudflare. Normalmente se configura en /admin/settings.
VITE_R2_WORKER_URL=

# Opcionales (tienen valores por defecto)
VITE_MEDIA_BUCKET=media
VITE_GITHUB_REPO=Freshkz/fresh-hub
VITE_GITHUB_BRANCH=main
VITE_CUPONS_STATUS_URL=
VITE_AI_STYLIST_STATUS_URL=
